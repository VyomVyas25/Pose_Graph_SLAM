Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 90; 90; 90
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (node scans at optimised poses)
      Enabled: true
      Topic:
        Value: /point_cloud_map
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 230; 230; 230
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Ground truth (Gazebo /odom)
      Enabled: true
      Topic:
        Value: /gt_path
      Color: 60; 140; 255
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Odometry alone (drift)
      Enabled: true
      Topic:
        Value: /odom_path
      Color: 255; 60; 60
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Optimised path
      Enabled: true
      Topic:
        Value: /optimized_path
      Color: 0; 220; 0
      Line Style: Billboards
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Pose graph (nodes, edges, loop closures)
      Enabled: true
      Topic:
        Value: /graph_markers
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Live scan
      Enabled: true
      Topic:
        Value: /scan
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 200; 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.5
      Value: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 45
      X: 4
      Y: -3.5
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1500
